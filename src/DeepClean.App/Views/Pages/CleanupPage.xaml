<UserControl
    x:Class="DeepClean.App.Views.Pages.CleanupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DeepClean.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:CleanupViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="RowLabel" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>

        <Style x:Key="Caption" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontTypography" Value="Subtitle" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

            <ui:TextBlock FontTypography="TitleLarge" FontWeight="SemiBold" Text="Deep clean" />
            <ui:TextBlock
                Margin="0,4,0,0"
                Appearance="Secondary"
                FontTypography="Caption"
                Text="A scan only looks at a fixed list of safe folders and never changes anything. Nothing is removed until you pick it and confirm." />

            <!--  Elevation notice  -->
            <StackPanel Margin="0,18,0,0" Visibility="{Binding ShowElevationNotice, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <ui:InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{Binding ElevationMessage, Mode=OneWay}"
                    Severity="Informational"
                    Title="Some categories need administrator rights" />
                <ui:Button
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    Command="{Binding RestartAsAdministratorCommand}"
                    Content="Restart as administrator"
                    Icon="{ui:SymbolIcon ShieldCheckmark24}" />
            </StackPanel>

            <!--  Actions  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Broom24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="What to clean" />
                    </StackPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button
                            Command="{Binding ScanCommand}"
                            Content="Scan"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            IsEnabled="{Binding CanScan}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ScanCancelCommand}"
                            Content="Cancel scan"
                            IsEnabled="{Binding CanCancelScan}"
                            Visibility="{Binding CanCancelScan, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Command="{Binding CleanCommand}"
                            Content="Clean selected"
                            Icon="{ui:SymbolIcon Broom24}"
                            IsEnabled="{Binding CanClean}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding CleanCancelCommand}"
                            Content="Cancel cleaning"
                            IsEnabled="{Binding IsCleaning}"
                            Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </WrapPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Only remove items older than" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="An extra age floor on top of each category's own rule. Anything younger is left alone." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="1"
                            MinWidth="230"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding AgeOptions}"
                            SelectedItem="{Binding MinimumAge, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Delete permanently instead of using the Recycle Bin" />
                            <ui:TextBlock
                                Style="{StaticResource Caption}"
                                Text="Off by default. While this is off, everything removed can still be restored from the Recycle Bin." />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding DeletePermanently, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Progress and status  -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <ProgressBar
                    Height="6"
                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                    Maximum="{Binding ProgressMaximum}"
                    Value="{Binding ProgressValue}" />
            </StackPanel>

            <ui:TextBlock
                Margin="0,10,0,0"
                FontTypography="BodyStrong"
                Text="{Binding StatusText}" />
            <ui:TextBlock
                Appearance="Secondary"
                FontFamily="Cascadia Mono, Consolas, Courier New"
                FontSize="12"
                Text="{Binding ProgressDetail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!--  Post clean summary  -->
            <ui:Card
                Margin="0,18,0,0"
                Padding="18"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="ShieldCheckmark24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SummaryTitle}" />
                    </StackPanel>

                    <ui:TextBlock
                        Margin="0,10,0,0"
                        Text="{Binding SummaryMessage}"
                        TextWrapping="Wrap" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SummaryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    FontTypography="Caption"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!--  Categories  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="List24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Categories" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding SelectAllCommand}"
                            Content="Select all"
                            IsEnabled="{Binding CanChangeSelection}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearSelectionCommand}"
                            Content="Clear selection"
                            IsEnabled="{Binding CanChangeSelection}" />
                    </StackPanel>

                    <ItemsControl
                        Margin="0,6,0,0"
                        IsEnabled="{Binding CanChangeSelection}"
                        ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        Margin="0,2,10,0"
                                        VerticalAlignment="Top"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        IsEnabled="{Binding IsAvailable}" />

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <ui:TextBlock Style="{StaticResource RowLabel}" Text="{Binding Name}" />
                                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding Description}" />
                                    </StackPanel>

                                    <ui:TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Appearance="Secondary"
                                        FontTypography="Caption"
                                        Text="{Binding SizeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:TextBlock
                        Margin="0,14,0,0"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="Windows Update files younger than two weeks are never listed. Files that are open in another program are skipped rather than forced." />
                </StackPanel>
            </ui:Card>

            <!--  Results  -->
            <ui:Card
                Margin="0,18,0,0"
                Padding="18"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="DataUsage24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="{Binding TotalText}" />
                    </StackPanel>

                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding PreviewCaption}" />

                    <Grid Margin="0,14,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBlock Grid.Column="0" Appearance="Secondary" FontTypography="Caption" Text="Category" />
                        <ui:TextBlock Grid.Column="1" Appearance="Secondary" FontTypography="Caption" Text="Location" />
                        <ui:TextBlock Grid.Column="2" Appearance="Secondary" FontTypography="Caption" Text="Size" />
                        <ui:TextBlock Grid.Column="3" Appearance="Secondary" FontTypography="Caption" Text="Age" />
                    </Grid>

                    <ItemsControl MaxHeight="420" ItemsSource="{Binding LargestItems}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="{x:Type ItemsControl}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBlock Grid.Column="0" FontTypography="Caption" Text="{Binding CategoryName}" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        FontFamily="Cascadia Mono, Consolas, Courier New"
                                        FontSize="12"
                                        Text="{Binding Path}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Path}" />
                                    <ui:TextBlock Grid.Column="2" FontTypography="Caption" Text="{Binding SizeText}" />
                                    <ui:TextBlock Grid.Column="3" Appearance="Secondary" FontTypography="Caption" Text="{Binding AgeText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding CleanCommand}"
                        Content="Clean selected"
                        Icon="{ui:SymbolIcon Broom24}"
                        IsEnabled="{Binding CanClean}" />
                </StackPanel>
            </ui:Card>

            <!--  Exclusions  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="FolderOpen24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Folders to leave alone" />
                    </StackPanel>

                    <ui:TextBlock
                        Style="{StaticResource Caption}"
                        Text="Anything inside these folders, however deep, is never reported or removed." />

                    <ListBox
                        Margin="0,12,0,0"
                        MaxHeight="180"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="."
                        ItemsSource="{Binding ExcludedPaths}"
                        SelectedItem="{Binding SelectedExclusion, Mode=TwoWay}" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding AddExclusionCommand}"
                            Content="Add folder"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Danger"
                            Command="{Binding RemoveExclusionCommand}"
                            Content="Remove"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  Recycle Bin  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Storage24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Recycle Bin" />
                    </StackPanel>

                    <ui:TextBlock
                        Style="{StaticResource Caption}"
                        Text="Items DeepClean removes with the Recycle Bin still take up space until it is emptied. Restoring them is always possible until then." />

                    <ui:TextBlock
                        Margin="0,10,0,0"
                        FontTypography="BodyStrong"
                        Text="{Binding RecycleBinText}" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding RefreshRecycleBinInfoCommand}"
                            Content="Refresh"
                            Icon="{ui:SymbolIcon ArrowClockwise24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Danger"
                            Command="{Binding EmptyRecycleBinCommand}"
                            Content="Empty the Recycle Bin"
                            Icon="{ui:SymbolIcon Broom24}"
                            IsEnabled="{Binding CanEmptyRecycleBin}" />
                    </StackPanel>

                    <ui:TextBlock
                        Margin="0,10,0,0"
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="Emptying the Recycle Bin asks for a separate confirmation, because those files cannot be recovered afterwards." />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
