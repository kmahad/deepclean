<UserControl
    x:Class="DeepClean.App.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DeepClean.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="RowLabel" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>

        <Style x:Key="Caption" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontTypography" Value="Subtitle" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="RowControl" TargetType="Control">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="230" />
        </Style>

        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

            <ui:TextBlock FontTypography="TitleLarge" FontWeight="SemiBold" Text="Settings" />
            <ui:TextBlock
                Margin="0,4,0,0"
                Appearance="Secondary"
                FontTypography="Caption"
                Text="Changes are saved straight away, so there is nothing to confirm." />

            <!--  Administrator  -->
            <ui:InfoBar
                Margin="0,18,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="DeepClean runs without administrator rights by default. Some future cleaning actions will ask for them only when you start that action."
                Severity="Informational"
                Title="Running with standard rights"
                Visibility="{Binding ShowElevationNotice, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />

            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="ShieldCheckmark24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Administrator rights" />
                    </StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Restart with administrator rights" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Windows shows a consent prompt. If you decline it, DeepClean keeps running unchanged." />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Command="{Binding RestartAsAdministratorCommand}"
                            Content="Restart elevated"
                            Icon="{ui:SymbolIcon ShieldCheckmark24}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Appearance  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Sparkle24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                    </StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Theme" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Match Windows, or pick a fixed look." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding Theme, Mode=TwoWay}"
                            Style="{StaticResource RowControl}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Monitoring  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Gauge24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Monitoring" />
                    </StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Sample interval" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="How often processor, graphics and memory readings are refreshed." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding IntervalOptions}"
                            SelectedItem="{Binding Interval, Mode=TwoWay}"
                            Style="{StaticResource RowControl}" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Graphics sensors" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Reads graphics load, temperature and dedicated memory where the hardware allows it." />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding EnableGpuMonitoring, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Show busiest processes" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Lists the processes using the most processor time and memory." />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding ShowProcessList, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Application  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Power24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Application" />
                    </StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Start with Windows" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Adds DeepClean to your own account's start-up entries." />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="When starting" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Choose whether the window appears or DeepClean waits in the notification area." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding StartupBehaviorOptions}"
                            SelectedItem="{Binding StartupBehavior, Mode=TwoWay}"
                            Style="{StaticResource RowControl}" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Close to notification area" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Keeps monitoring in the background instead of exiting when you close the window." />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding CloseToTray, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Show notifications" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Displays a short message when a setting or an action finishes." />
                        </StackPanel>
                        <ui:ToggleSwitch
                            Grid.Column="1"
                            IsChecked="{Binding EnableNotifications, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Logging  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Bug24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Logging" />
                    </StackPanel>

                    <Grid Style="{StaticResource RowGrid}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Detail level" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Applies the next time DeepClean starts." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding LogLevelOptions}"
                            SelectedItem="{Binding LogLevel, Mode=TwoWay}"
                            Style="{StaticResource RowControl}" />
                    </Grid>

                    <Separator Margin="0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Keep logs for" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Older files are removed automatically." />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding RetainedLogFilesOptions}"
                            SelectedItem="{Binding RetainedLogFiles, Mode=TwoWay}"
                            Style="{StaticResource RowControl}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Storage  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Storage24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Files on this computer" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource RowGrid}">
                        <ui:TextBlock Style="{StaticResource RowLabel}" Text="Settings" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding DataFolderPath}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <ui:TextBlock Style="{StaticResource RowLabel}" Text="Logs" />
                        <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding LogFolderPath}" />
                    </StackPanel>

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding OpenDataFolderCommand}"
                            Content="Open data folder"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding OpenLogFolderCommand}"
                            Content="Open log folder"
                            Icon="{ui:SymbolIcon DocumentText24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Danger"
                            Command="{Binding ResetToDefaultsCommand}"
                            Content="Reset all settings"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
