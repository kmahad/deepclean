<UserControl
    x:Class="DeepClean.App.Views.Pages.DuplicatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:DeepClean.App.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:DuplicatesViewModel}"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="RowLabel" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="FontTypography" Value="BodyStrong" />
        </Style>

        <Style x:Key="Caption" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="FontTypography" Value="Caption" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type ui:TextBlock}">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontTypography" Value="Subtitle" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="28,20,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Stretch">

            <ui:TextBlock FontTypography="TitleLarge" FontWeight="SemiBold" Text="Duplicate finder" />
            <ui:TextBlock
                Margin="0,4,0,0"
                Appearance="Secondary"
                FontTypography="Caption"
                Text="A scan only reads files and compares their contents. Nothing is picked for you, and a copy is only removed after you confirm." />

            <!--  Folders to search  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="FolderSearch24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Folders to search" />
                    </StackPanel>

                    <ui:TextBlock
                        Style="{StaticResource Caption}"
                        Text="Everything below these folders is searched, links excepted. Windows folders are never searched, and your personal folders are added for you." />

                    <ListBox
                        Margin="0,12,0,0"
                        MaxHeight="180"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="."
                        ItemsSource="{Binding Roots}"
                        SelectedItem="{Binding SelectedRoot, Mode=TwoWay}" />

                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button
                            Command="{Binding AddFolderCommand}"
                            Content="Add folder"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding AddPersonalFoldersCommand}"
                            Content="Add my personal folders"
                            Icon="{ui:SymbolIcon Person24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding RemoveRootCommand}"
                            Content="Remove"
                            Icon="{ui:SymbolIcon Subtract24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearRootsCommand}"
                            Content="Clear list"
                            Icon="{ui:SymbolIcon Delete24}" />
                    </WrapPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Ignore files smaller than" />
                            <ui:TextBlock Style="{StaticResource Caption}" Text="Small files rarely free much space, and skipping them makes the scan much quicker." />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="1"
                            MinWidth="230"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding SizeOptions}"
                            SelectedItem="{Binding MinimumSize, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <!--  Actions  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Search24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Find and remove" />
                    </StackPanel>

                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button
                            Command="{Binding ScanCommand}"
                            Content="Scan for duplicates"
                            Icon="{ui:SymbolIcon Search24}"
                            IsEnabled="{Binding CanScan}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ScanCancelCommand}"
                            Content="Cancel scan"
                            IsEnabled="{Binding CanCancelScan}"
                            Visibility="{Binding CanCancelScan, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Command="{Binding DeleteCommand}"
                            Content="Remove selected copies"
                            Icon="{ui:SymbolIcon Delete24}"
                            IsEnabled="{Binding CanDelete}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding DeleteCancelCommand}"
                            Content="Cancel removal"
                            IsEnabled="{Binding IsDeleting}"
                            Visibility="{Binding IsDeleting, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </WrapPanel>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="Delete permanently instead of using the Recycle Bin" />
                            <ui:TextBlock
                                Style="{StaticResource Caption}"
                                Text="Off by default. Copies found in your personal folders always go to the Recycle Bin, whatever this is set to." />
                        </StackPanel>

                        <CheckBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            IsChecked="{Binding DeletePermanently, Mode=TwoWay}" />
                    </Grid>

                    <Separator Margin="0,14" />

                    <ui:TextBlock
                        FontTypography="BodyStrong"
                        Text="{Binding SelectedSizeText}" />
                </StackPanel>
            </ui:Card>

            <!--  Progress and status  -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <ProgressBar
                    Height="6"
                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                    Maximum="{Binding ProgressMaximum}"
                    Value="{Binding ProgressValue}" />
            </StackPanel>

            <ui:TextBlock
                Margin="0,10,0,0"
                FontTypography="BodyStrong"
                Text="{Binding StatusText}" />
            <ui:TextBlock
                Appearance="Secondary"
                FontFamily="Cascadia Mono, Consolas, Courier New"
                FontSize="12"
                Text="{Binding ProgressDetail, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />

            <!--  Post removal summary  -->
            <ui:Card
                Margin="0,18,0,0"
                Padding="18"
                Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="ShieldCheckmark24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="{Binding SummaryTitle}" />
                    </StackPanel>

                    <ui:TextBlock
                        Margin="0,10,0,0"
                        Text="{Binding SummaryMessage}"
                        TextWrapping="Wrap" />

                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SummaryLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:TextBlock
                                    Appearance="Secondary"
                                    FontTypography="Caption"
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!--  Results  -->
            <ui:Card
                Margin="0,18,0,0"
                Padding="18"
                Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="Copy24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="{Binding TotalText}" />
                    </StackPanel>

                    <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding ResultsCaption}" />

                    <WrapPanel Margin="0,12,0,0">
                        <ui:Button
                            Command="{Binding SelectAllCopiesCommand}"
                            Content="Select copies, keep the suggested one"
                            IsEnabled="{Binding CanChangeSelection}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ClearSelectionCommand}"
                            Content="Clear selection"
                            IsEnabled="{Binding CanChangeSelection}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding ExpandAllCommand}"
                            Content="Expand all" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Command="{Binding CollapseAllCommand}"
                            Content="Collapse all" />
                    </WrapPanel>

                    <ItemsControl
                        Margin="0,12,0,0"
                        IsEnabled="{Binding CanChangeSelection}"
                        ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander
                                    Margin="0,0,0,8"
                                    IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                    <Expander.Header>
                                        <StackPanel Margin="0,2,0,2">
                                            <ui:TextBlock Style="{StaticResource RowLabel}" Text="{Binding HeaderText}" />
                                            <ui:TextBlock Style="{StaticResource Caption}" Text="{Binding SelectionText}" />
                                        </StackPanel>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Candidates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="150" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox
                                                        Grid.Column="0"
                                                        Margin="0,2,10,0"
                                                        VerticalAlignment="Top"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                        <ui:TextBlock Style="{StaticResource RowLabel}" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                                        <ui:TextBlock
                                                            Style="{StaticResource Caption}"
                                                            FontFamily="Cascadia Mono, Consolas, Courier New"
                                                            FontSize="12"
                                                            Text="{Binding FolderPath}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip="{Binding Path}" />
                                                        <ui:TextBlock
                                                            Margin="0,2,0,0"
                                                            Appearance="Secondary"
                                                            FontTypography="Caption"
                                                            Text="{Binding LocationNote}"
                                                            TextWrapping="Wrap"
                                                            Visibility="{Binding RecycleOnly, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                                    </StackPanel>

                                                    <ui:TextBlock Grid.Column="2" VerticalAlignment="Center" Appearance="Secondary" FontTypography="Caption" Text="{Binding SizeText}" />
                                                    <ui:TextBlock Grid.Column="3" VerticalAlignment="Center" Appearance="Secondary" FontTypography="Caption" Text="{Binding AgeText}" />

                                                    <ui:TextBlock
                                                        Grid.Column="4"
                                                        Margin="12,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Appearance="Secondary"
                                                        FontTypography="Caption"
                                                        Text="Suggested to keep"
                                                        Visibility="{Binding IsSuggestedKeep, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:Button
                        Margin="0,14,0,0"
                        HorizontalAlignment="Left"
                        Appearance="Primary"
                        Command="{Binding DeleteCommand}"
                        Content="Remove selected copies"
                        Icon="{ui:SymbolIcon Delete24}"
                        IsEnabled="{Binding CanDelete}" />
                </StackPanel>
            </ui:Card>

            <!--  Exclusions  -->
            <ui:Card Margin="0,18,0,0" Padding="18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="18" Symbol="FolderOpen24" />
                        <ui:TextBlock Style="{StaticResource SectionTitle}" Text="Folders to leave alone" />
                    </StackPanel>

                    <ui:TextBlock
                        Style="{StaticResource Caption}"
                        Text="Anything inside these folders, however deep, is never reported or removed. The same list is used by deep clean." />

                    <ListBox
                        Margin="0,12,0,0"
                        MaxHeight="180"
                        Background="Transparent"
                        BorderThickness="0"
                        DisplayMemberPath="."
                        ItemsSource="{Binding ExcludedPaths}"
                        SelectedItem="{Binding SelectedExclusion, Mode=TwoWay}" />

                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <ui:Button
                            Command="{Binding AddExclusionCommand}"
                            Content="Add folder"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Danger"
                            Command="{Binding RemoveExclusionCommand}"
                            Content="Remove"
                            Icon="{ui:SymbolIcon ArrowSync24}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
