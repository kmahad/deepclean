<ui:FluentWindow
    x:Class="DeepClean.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ni="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:pages="clr-namespace:DeepClean.App.Views.Pages"
    Title="DeepClean"
    Width="1120"
    Height="740"
    MinWidth="900"
    MinHeight="620"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Title="DeepClean"
            Icon="{ui:SymbolIcon Broom24}"
            ShowHelp="False">
            <ui:TitleBar.TrailingContent>
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ElevationText}" />
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <ui:NavigationView
                x:Name="RootNavigation"
                PaneDisplayMode="Left"
                OpenPaneLength="236"
                CompactPaneLength="48"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleVisible="True"
                IsTopSeparatorVisible="False">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem
                        Content="Dashboard"
                        Icon="{ui:SymbolIcon Home24}"
                        TargetPageType="{x:Type pages:DashboardPage}" />
                    <ui:NavigationViewItem
                        Content="Deep clean"
                        Icon="{ui:SymbolIcon Broom24}"
                        TargetPageType="{x:Type pages:CleanupPage}" />
                    <ui:NavigationViewItem
                        Content="Duplicates"
                        Icon="{ui:SymbolIcon Copy24}"
                        TargetPageType="{x:Type pages:DuplicatesPage}" />
                    <ui:NavigationViewItem
                        Content="Logs and diagnostics"
                        Icon="{ui:SymbolIcon DocumentText24}"
                        TargetPageType="{x:Type pages:LogsPage}" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        Content="Settings"
                        Icon="{ui:SymbolIcon Settings24}"
                        TargetPageType="{x:Type pages:SettingsPage}" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <ui:SnackbarPresenter
                x:Name="SnackbarPresenter"
                Margin="16"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom" />
        </Grid>

        <ni:TaskbarIcon
            x:Name="TrayIcon"
            Grid.RowSpan="2"
            NoLeftClickDelay="True"
            IconSource="pack://application:,,,/Assets/app.ico"
            ToolTipText="{Binding TrayToolTip}"
            LeftClickCommand="{Binding ShowWindowCommand}"
            DoubleClickCommand="{Binding ShowWindowCommand}">
            <ni:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open DeepClean" Command="{Binding ShowWindowCommand}" FontWeight="SemiBold" />
                    <Separator />
                    <MenuItem Header="Dashboard" Command="{Binding OpenDashboardCommand}" />
                    <MenuItem Header="Deep clean" Command="{Binding OpenCleanupCommand}" />
                    <MenuItem Header="Duplicates" Command="{Binding OpenDuplicatesCommand}" />
                    <MenuItem Header="Logs and diagnostics" Command="{Binding OpenLogsCommand}" />
                    <MenuItem Header="Settings" Command="{Binding OpenSettingsCommand}" />
                    <Separator />
                    <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
                </ContextMenu>
            </ni:TaskbarIcon.ContextMenu>
        </ni:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
